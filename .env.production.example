# Variables NO secretas de ejemplo para GCP Compute Engine. Configurar desde cero.
# NO copiar a .env.production sin generar contraseñas y APP_KEY únicas.
APP_NAME="Ficha Clinica TP"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://TU_DOMINIO_PUBLICO
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Santiago
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ficha_clinica
DB_USERNAME=ficha
DB_PASSWORD=REEMPLAZAR_PASSWORD_SEGURA_MYSQL
MYSQL_ROOT_PASSWORD=REEMPLAZAR_PASSWORD_ROOT_MYSQL
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_HOST=SERVIDOR_SMTP_AUTORIZADO
MAIL_PORT=587
MAIL_USERNAME=CUENTA_SMTP
MAIL_PASSWORD=PASSWORD_SMTP_AUTORIZADA
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=notificaciones@ejemplo.cl
MAIL_FROM_NAME="Ficha Clinica TP"
