# PLANTILLA GCP, NO contiene secretos. Copiar a .env SOLO al configurar el servicio.
# El docker-compose.yml de Alexis SE CONSERVA sin cambios para desarrollo local.
APP_NAME="Ficha Clinica TP"
APP_ENV=production
APP_KEY=
# Crear APP_KEY con php artisan key:generate (no compartir).
APP_DEBUG=false
APP_URL=https://URL-REAL-HTTPS
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Santiago
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
# Cloud SQL MySQL: elegir UNA opción de conexión ver guia GCP (no valor automático)
DB_HOST=HOST_PRIVADO_CLOUD_SQL
DB_PORT=3306
DB_DATABASE=ficha_clinica
DB_USERNAME=USUARIO_DB_SECRETO
DB_PASSWORD=PASSWORD_DB_SECRETO
# Cloud Run + conector Cloud SQL Unix Socket puede requerir DB_SOCKET según arquitectura:
# DB_SOCKET=/cloudsql/PROJECT_ID:REGION:INSTANCE_ID
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
# ATENCION: Cloud Run tiene filesystem efimero. Archivos persistentes requieren GCS.
# MAIL_FROM_ADDRESS no autoriza envios automaticamente: habilitar un SMTP aprobado.
MAIL_MAILER=smtp
MAIL_HOST=SERVIDOR_SMTP_AUTORIZADO
MAIL_PORT=587
MAIL_USERNAME=CUENTA_SMTP
MAIL_PASSWORD=PASSWORD_SMTP_SECRETO
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="notificaciones@ejemplo.cl"
MAIL_FROM_NAME="Ficha Clinica TP"
FRONTEND_URL=https://URL-REAL-HTTPS
VITE_APP_NAME="Ficha Clinica TP"
