APP_NAME="Ficha Clinica TP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL
APP_TIMEZONE=America/Santiago

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
BCRYPT_ROUNDS=12

# Ajustar según el entorno. Docker Compose de Alexis utiliza MySQL, host db.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ficha_clinica
DB_USERNAME=ficha
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit en el docker-compose.yml original captura emails en localhost:8025;
# no los entrega fuera. La dirección siguiente es solo el remitente solicitado.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="pabl.chacon@duocuc.cl"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:8000
VITE_APP_NAME="${APP_NAME}"
